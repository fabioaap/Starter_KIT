{
  "name": "starterkit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Starter Kit para Next.js, Tailwind CSS, Storybook, shadcn/ui, MSW e Style Dictionary.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/tokens"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:tokens": "style-dictionary build --config packages/tokens/style-dictionary.config.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.370.0",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/builder-vite": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@tokens-studio/sd-transforms": "^4.0.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "msw": "^2.2.4",
    "msw-storybook-addon": "^2.0.2",
    "postcss": "^8.4.38",
    "storybook": "^8.0.0",
    "style-dictionary": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.3"
  }
}
